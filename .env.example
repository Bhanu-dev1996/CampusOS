# Shared local infrastructure credentials (Postgres in Docker).
# Copy to repo root as `.env` when running Docker Compose from the root:
#   copy .env.example .env
#
# App runtime config lives in each workspace — do not merge into one file:
#   apps/api/.env.example   -> apps/api/.env
#   apps/web/.env.local.example -> apps/web/.env.local

POSTGRES_USER=campusos
POSTGRES_PASSWORD=campusos
POSTGRES_DB=campusos

# Use these values in apps/api/.env:
# DATABASE_URL=postgresql+asyncpg://campusos:campusos@localhost:5432/campusos
# REDIS_URL=redis://localhost:6379/0