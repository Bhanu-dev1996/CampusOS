# Supabase — Dashboard → Project Settings → Database → Connect → Direct connection (port 5432)
# URL-encode special characters in the password (@ → %40, etc.)
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_SSL=true
# Set false only in development if alembic fails with SSLCertVerificationError (corporate proxy)
DATABASE_SSL_VERIFY=true

REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
APP_ENV=development
CORS_ORIGINS=http://localhost:3000