# --- Supabase (recommended for you) ---
# Dashboard → Project Settings → Database → Connect → "URI"
# 1) Replace leading postgresql:// with postgresql+asyncpg://  (or paste as-is; app fixes it)
# 2) For Alembic migrations, use **Direct connection** (db.xxx.supabase.co:5432), NOT Transaction pooler :6543
# 3) URL-encode special characters in the password (@ → %40, etc.)
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# --- Local Docker / Postgres fallback ---
# DATABASE_URL=postgresql+asyncpg://campusos:campusos@localhost:5432/campusos
# DATABASE_SSL=false

REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
APP_ENV=development
CORS_ORIGINS=http://localhost:3000